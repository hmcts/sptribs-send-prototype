{% extends "_layouts/citizen.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
  {{ govukBackLink({ text: back, href: backHref }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors | length %}
        {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: errors | govukErrorSummary }) }}
      {% endif %}

      <form method="post" novalidate>
        {% include "_partials/csrf-input.njk" %}
        <span class="govuk-caption-l">{{ caption }}</span>

        {% set planSectionsItems = [] %}
        {% for option in planSectionsOptions %}
          {% set _ = planSectionsItems.push({
            value: option.value,
            text: option.text,
            hint: { text: option.hint } if option.hint,
            checked: option.value in values.planSections
          }) %}
        {% endfor %}
        {{ govukCheckboxes({
          name: "planSections",
          idPrefix: "planSections",
          fieldset: { legend: { text: planSectionsLabel, isPageHeading: true, classes: "govuk-fieldset__legend--l" } },
          hint: { text: planSectionsHint },
          items: planSectionsItems,
          errorMessage: { text: errors.planSections } if errors.planSections
        }) }}

        {{ govukButton({ text: continueText or save }) }}
      </form>
    </div>
  </div>
{% endblock %}
