{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  // src/libs is NOT excluded: a lib nothing imports yet (e.g. #answers, #fees)
  // must still be type-checked and emitted, or it is missing from dist and only
  // fails when the first page finally imports it.
  //
  // __fixtures__ IS excluded, matching vitest.config.ts: those are test-only
  // helpers and sample data, and emitting them puts test scaffolding — and the
  // sample form JSON — into the deployed image.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__fixtures__/**", "src/assets/**/*", "test/**/*"]
}
